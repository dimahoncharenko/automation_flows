{
  "name": "AliExpress Scraper via Apify",
  "nodes": [
    {
      "parameters": {
        "compare": "selectedFields",
        "fieldsToCompare": "productId",
        "options": {}
      },
      "id": "ca7071e3-fd09-4b64-9234-0fc9920502d6",
      "name": "Remove Duplicates",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 1,
      "position": [
        336,
        160
      ],
      "notes": "Deduplicates products by their ID."
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const d = item.json;\n  return {\n    json: {\n      productId: d.productId || '',\n      title: d.title?.displayTitle || '',\n      currentPrice: d.prices?.salePrice?.minPrice || d.extractedData?.currentPrice || 0,\n      originalPrice: d.prices?.originalPrice?.minPrice || d.extractedData?.originalPrice || 0,\n      discount: d.extractedData?.discountPercent || d.prices?.salePrice?.discount || 0,\n      currency: d.prices?.currencyCode || 'USD',\n      rating: d.evaluation?.starRating || d.extractedData?.rating || null,\n      totalOrders: d.extractedData?.totalOrders || 0,\n      imageUrl: d.image?.imgUrl || d.images?.[0]?.imgUrl || '',\n      productUrl: d.productDetailUrl || '',\n      storeName: d.store?.storeName || '',\n      coupons: (d.sellingPoints || [])\n        .filter(sp => sp.tagContent?.tagText)\n        .map(sp => sp.tagContent.tagText)\n        .join('; '),\n      scrapedAt: d.scrapedAt || new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "5065b789-f953-40c3-b4bf-c8b8cdf66f9f",
      "name": "Normalize Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        160
      ],
      "notes": "Normalizes scraped data into a clean, consistent format. Adjust field mappings if the actor output schema changes."
    },
    {
      "parameters": {
        "operation": "Run actor and get dataset",
        "actorSource": "store",
        "actorId": {
          "__rl": true,
          "value": "mfblss3fLQRaqhg6K",
          "mode": "id"
        },
        "customBody": "{\n    \"deduplicateProducts\": true,\n    \"includeDescription\": true,\n    \"includeQuestions\": false,\n    \"includeReviews\": false,\n    \"includeShippingDetails\": false,\n    \"includeVariants\": false,\n    \"maxItems\": 10,\n    \"queries\": [\n        \"fpv\",\n        \"graphic cards\",\n        \"LiPo\",\n        \"vtx\"\n    ],\n    \"sortBy\": \"rating\"\n}",
        "authentication": "apifyOAuth2Api"
      },
      "type": "@apify/n8n-nodes-apify.apify",
      "typeVersion": 1,
      "position": [
        80,
        176
      ],
      "id": "fd3cb178-d7f5-4c46-bdd7-97f9379e37a4",
      "name": "Run an Actor and get dataset",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "credentials": {},
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "",
        "file": "={{ $json.imageUrl }}",
        "additionalFields": {
          "caption": "=<a href=\"{{ $json.productUrl }}\">​</a><b>{{ $json.title }}</b>\n\n💰 <b>${{ $json.currentPrice }}</b>  <s>${{ $json.originalPrice }}</s>  (-{{ $json.discount }}%)\n⭐ {{ $json.rating || 'N/A' }}  •  📦 {{ $json.totalOrders }} sold\n{{ $json.coupons ? '\\n🏷️ ' + $json.coupons : '' }}\n\n🔗 <a href=\"{{ $json.productUrl }}\">View on AliExpress</a>",
          "parse_mode": "HTML"
