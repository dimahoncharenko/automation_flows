    {
      "parameters": {
        "jsCode": "const item = $('Loop Over Items').item.json;\nconst llmText = $('LLM: process a post').item.json.text;\n\nconst ownImage = item.enclosure?.url || '';\n\nconst link = item.link || '';\nlet fallbackImage = '';\n\nif (link.includes('openai.com')) {\n  fallbackImage = 'https://opendatascience.com/wp-content/uploads/2023/03/Untitled-design-2-1.png';\n} else if (link.includes('deepmind.google')) {\n  fallbackImage = 'https://rizonetech.com/wp-content/uploads/2023/06/google-deepmind.jpg';\n} else if (link.includes('ain.ua')) {\n  fallbackImage = 'https://mmr.ua/wp-content/uploads/2024/03/431064351_855591153246488_6810692508207778580_n-1024x1024.jpg';\n} else if (link.includes('itc.ua')) {\n  fallbackImage = 'https://itc.ua/wp-content/uploads/2021/11/itc-1.jpg';\n} else if (link.includes('dev.to')) {\n  fallbackImage = 'https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/4c/ab/cf/4cabcfca-1a37-559f-df71-de872b59368a/AppIcon-1x_U007emarketing-0-7-0-85-220.png/1200x630wa.png';\n} else if (link.includes('css-tricks.com')) {\n  fallbackImage = 'https://cssauthor.com/wp-content/uploads/2015/03/CSS-Tricks-1.jpg';\n} else if (link.includes('itpro.com')) {\n  fallbackImage = 'https://cdn-1.webcatalog.io/catalog/itpro/itpro-social-preview.png?v=1716618006397';\n} else if (link.includes('unian.net')) {\n  fallbackImage = 'https://cdn-1.webcatalog.io/catalog/unian/unian-social-preview.png?v=1732989400222';\n} else {\n  fallbackImage = 'https://t3.ftcdn.net/jpg/02/48/42/64/360_F_248426448_NVKLywWqArG2ADUxDq6QprtIzsF82dMF.jpg'\n}\n\nconst imageUrl = ownImage || fallbackImage;\n\nreturn [{\n  json: {\n    text: llmText,\n    imageUrl: imageUrl\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
